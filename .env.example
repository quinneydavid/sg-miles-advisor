# sg-card-advisor: what the app needs before it can start. Copy to .env.
# Everything else (mailboxes, the model, messages, people, the catalogue run) is set in the app:
# Settings for each person, App settings for an admin.

# --- database ---------------------------------------------------------------------------------------------------------
# Choose one before the first start, for example with: openssl rand -hex 16
# compose.yaml refuses to start while it is empty.
PGPASSWORD=
# PGHOST=localhost            # compose.yaml sets db
# PGDATABASE=cards
# PGUSER=cards
# PGSSLMODE=require           # compose.yaml sets disable (same Docker network)
# DATABASE_URL=               # a full connection string; replaces the five settings above
# PGPOOL=6                    # pooled connections

# --- signing in -------------------------------------------------------------------------------------------------------
# One person, no login. For a private machine only: everyone who can reach port 8080 is this person.
# Remove it when a forward-auth proxy sits in front and sets Remote-User; the first person the proxy names
# becomes the admin and adds the others in the app.
CARDS_SINGLE_USER=me
# With CARDS_SINGLE_USER the app answers only when opened as 127.0.0.1, localhost or [::1]. List any other name it is
# opened under (comma-separated), for example the name a proxy in front serves it as.
# CARDS_HOSTS=cards.example
# CF_ACCESS_AUD=              # public door (Cloudflare tunnel + Access, port 8081): audience tag of the Access
                              # application; empty = the public door refuses everyone
# CARDS_PUBLIC_PORT=8081

# --- encryption of personal data (pick one) --------------------------------------------------------------------------
# Local key: a file with a base64 32-byte key, made on first start. compose.yaml sets /keys/cards.key.
# CARDS_KEY_FILE=/keys/cards.key
# CARDS_LOCAL_KEY=            # the same key given directly (openssl rand -base64 32)
# Vault Transit instead of a local key:
# VAULT_ADDR=https://vault.example
# VAULT_TRANSIT_KEY=cards
# VAULT_AUTH_MOUNT=kubernetes # Kubernetes auth with the pod's ServiceAccount
# VAULT_ROLE=cards
# VAULT_TOKEN=                # or a token, outside Kubernetes

# --- files ------------------------------------------------------------------------------------------------------------
# CARDS_INBOX_DIR=/inbox      # statement PDFs dropped in <dir>/<person id>/ are read by ingest
# TZ=Asia/Singapore
